#inum2_sizeclude <string>
#include <algorithm>

class Solution {
public:
    std::string multiply(std::string num1, std::string num2) {
        
        if (num1 == "0" || num2 == "0") return "0"; // Если хотя бы один из множителей равен нулю, результат "0"
        
        int num1_size = num1.size(), num2_size = num2.size(); // Длины входных строк
        
        std::string result(num1_size + num2_size, '0'); // Результат умножения может занимать не более num1_size + num2_size, строка заполнена нулями. 
        
        for (int i = num1_size - 1; i >= 0; --i) { // Перебираем цифры первого числа справа налево
            for (int j = num2_size - 1; j >= 0; --j) { // Перебираем цифры второго числа справа налево
                int mul = (num1[i] - '0') * (num2[j] - '0'); // Преобразуем символы в числа
                
                int sum = mul + (result[i + j + 1] - '0'); // Прибавляем к произведению уже накопленное значение
                
                result[i + j + 1] = (sum % 10) + '0'; // Записываем младшую цифру суммы в текущую позицию
                
                result[i + j] += sum / 10; // Добавляем перенос (старшую часть суммы) в позицию слева
            }
        }
        
        size_t start = result.find_first_not_of('0'); // Удаляем ведущие нули из результата
        
        return (start == std::string::npos) ? "0" : result.substr(start); // Если строка состоит только из нулей, возвращаем "0"
    }
};
