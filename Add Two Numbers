/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
public:
    ListNode* addTwoNumbers(ListNode* l1, ListNode* l2) 
    {
        ListNode dummy(0);       
        ListNode* curr = &dummy; 
        // curr указывает на последний узел результата и по мере добавления новых узлов двигается вперёд. dummy не двигаем.


        int carry {0}; // перенос в следующий разряд (0 или 1)

        while (l1 != nullptr || l2 != nullptr || carry != 0)
        {
            int sum = carry; // начинаем сумму с переноса

            if (l1 != nullptr) // берём цифру из первого списка, если он ещё не закончился
            {
                sum += l1->val;
                l1 = l1->next; // сдвигаем на следующую позицию
            }

            if (l2 != nullptr) // берём цифру из второго списка, если он ещё не закончился
            {
                sum += l2->val;
                l2 = l2->next; // сдвигаем на следующую позицию
            }

            curr->next = new ListNode(sum % 10); // Записываем младшую цифру суммы в новый узел результата.

            curr = curr->next; // сдвигаем на следующую позицию

            carry = sum / 10; // переносим старший разряд (0 или 1)
        }

        return dummy.next;
        
    }
};
