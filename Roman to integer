class Solution {
public:

    int value(char c) //Функция возвращает числовое значение римского символа
    {
        if (c == 'I') return 1;
        if (c == 'V') return 5;
        if (c == 'X') return 10;
        if (c == 'L') return 50;
        if (c == 'C') return 100;
        if (c == 'D') return 500;
        if (c == 'M') return 1000;

        return 0; //Если символ неизвестный, возвращаем 0
    }

    int romanToInt(string s) 
    {
        int result {0};//итоговое число
        
        for (int i = 0; i < s.size(); i++) //проход по всем символам строки
        {
            if (i + 1 < s.size() && value(s[i]) < value(s[i + 1])) // Проверка есть ли следующий символ и меньше ли текущее значение следующего
                result -= value(s[i]);
            else
                result += value(s[i]); //во всех остальных случаях прибавляем значение
        }

        return result;
    }
};
