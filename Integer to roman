class Solution {
public:
    string intToRoman(int num) 
    {
        vector<pair<int, string>> roman = // Таблица: значение и соответствующий римский символ
        {
            {1000, "M"},  {900, "CM"}, {500, "D"},  {400, "CD"},
            {100,  "C"},  {90,  "XC"}, {50,  "L"},  {40,  "XL"},
            {10,   "X"},  {9,   "IX"}, {5,   "V"},  {4,   "IV"},
            {1,    "I"}
        };
        
        string result;  //строка в которую будет записан конечный ответ

        for (auto& [value, symbol] : roman) // перебор от больших значений к меньшим

        {
            while (num >= value) // Проходимся по таблице и пока число больше или равно мы дописываем символ и вычитаем значение символа
            {
                result += symbol;
                num -= value;
            }
        }

        return result;
    }
};
