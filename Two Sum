class Solution {
public:
    vector<int> twoSum(vector<int>& nums, int target) {
        for (int i = 0; i < nums.size(); i++) { //перебор первого слагаемого
            for (int j = i + 1; j < nums.size(); j++) { //перебор второго слагаемого
                if (nums[i] + nums[j] == target) { //сравнение сумм
                    return {i, j}; //возвразаем индексы
                }
            }
        }

        return {};
    }
};
